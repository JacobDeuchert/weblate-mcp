# Weblate Configuration
WEBLATE_API_URL=https://your-weblate-instance.com/api/
WEBLATE_API_TOKEN=your-api-token-here

# MCP Server Configuration
MCP_SERVER_NAME=weblate-mcp-server
MCP_SERVER_VERSION=1.0.0
PORT=3000

# Optional: restrict which languages can be written via the MCP.
# Comma-separated allowlist, e.g. ALLOWED_LANGUAGES=de,fr,sk
# Empty/unset = all languages allowed. Matching is case-insensitive,
# `_` and `-` are treated as equivalent (pt_BR matches pt-BR).
# Enforced on writeTranslation, bulkWriteTranslations, createTranslationUnit.
# listLanguages is filtered to allowed languages. Reads are not blocked.
ALLOWED_LANGUAGES=

# Optional: Default project slugs (can be overridden in tool calls)
DEFAULT_OLD_PROJECT_SLUG=old-project
DEFAULT_NEW_PROJECT_SLUG=new-project 